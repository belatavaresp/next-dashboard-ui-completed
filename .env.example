# MongoDB connection string for the existing Atlas cluster.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Database the new app reads and writes. The legacy database is left untouched so
# the old tle-api.vercel.app deployment keeps working as a fallback.
MONGODB_DB="tle_v2"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Only needed when running `npm run migrate:users`.
# Set this to the legacy database name to migrate directly from the cluster;
# leave it unset to read the users from the still-running legacy API instead.
# LEGACY_MONGODB_DB="test"
# LEGACY_API_URL="https://tle-api.vercel.app/api/user/listAllUsers"
