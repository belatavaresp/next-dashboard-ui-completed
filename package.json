{
  "name": "tle-lab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "//": "Pinned to match .nvmrc. An open range let Vercel silently build on Node 24.",
    "node": "22.x"
  },
  "config": {
    "mongodbMemoryServer": {
      "//": "Skip the MongoDB binary download on install; only `npm run verify` needs it, and it fetches on first use.",
      "disablePostinstall": "1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-public-images.ts",
    "build": "next build",
    "gen:images": "tsx scripts/generate-public-images.ts",
    "start": "next start",
    "lint": "eslint .",
    "verify": "tsx scripts/verify.ts",
    "migrate:users": "tsx scripts/migrate-users.ts",
    "seed:activities": "tsx scripts/seed-activities.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0",
    "mongoose": "^8.24.2",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
